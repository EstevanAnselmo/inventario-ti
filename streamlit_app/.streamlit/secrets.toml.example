# Copie este arquivo para secrets.toml no mesmo diretorio.
# secrets.toml NUNCA deve ser enviado ao Git.

[auth]
usuario = "usuario_demo"
# Gere um hash SHA-256 para uso local de desenvolvimento:
# python -c "import hashlib; print(hashlib.sha256(b'SUA_SENHA_AQUI').hexdigest())"
senha_sha256 = "COLE_AQUI_O_HASH_GERADO"

[api]
base_url = "http://127.0.0.1:8000"
