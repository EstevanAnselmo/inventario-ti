# Copie este arquivo para secrets.toml (mesmo diretório) e preencha.
# secrets.toml NUNCA deve ir para o controle de versão (git) —
# adicione ".streamlit/secrets.toml" ao .gitignore.

[auth]
usuario = "admin"
# Gere o hash da sua senha rodando no terminal:
#   python -c "import hashlib; print(hashlib.sha256(b'SUA_SENHA_AQUI').hexdigest())"
senha_sha256 = "COLE_AQUI_O_HASH_GERADO"

[api]
base_url = "http://127.0.0.1:8000"
